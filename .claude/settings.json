{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-typecheck.sh",
            "asyncRewake": true,
            "statusMessage": "Lint + typecheck..."
          }
        ]
      }
    ]
  }
}
