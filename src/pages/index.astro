---
import TeamList, { type TeamListRow } from "@/components/team/TeamList";
import AppLayout from "@/layouts/AppLayout.astro";
import { createClient } from "@/lib/supabase";
import { listTeams } from "@/lib/team-repo";

// Lista **wyłącznie własnych** drużyn (FR-005): własność odcina polityka `select` (RLS), więc
// strona niczego nie filtruje. Strona główna jest chroniona wpisem dokładnym w `src/lib/routes.ts`,
// więc niezalogowany trafia na logowanie (FR-004).
//
// `null` znaczy „awaria odczytu", `[]` znaczy „nowe konto" — dwa różne ekrany, więc dwie różne
// wartości; `listTeams` celowo nie rzuca przy zerze wierszy.
//
// Data przychodzi już sformatowana, bo `Intl.DateTimeFormat.format` rzuca `RangeError` na
// `Invalid Date` — w szablonie taki wyjątek jest poza `try` niżej i wywróciłby cały render, czyli
// 500 w Workerze. Formatowanie przy odczycie wpina go w tę samą gałąź awarii co błąd zapytania.
//
// Kształt wiersza jest **jeden**, wzięty z wyspy (`TeamListRow`): strona składa dokładnie to, co
// wyspa konsumuje, więc rozjazd między nimi jest błędem typów, a nie pustym miejscem na ekranie.
//
// Strona **przestała być czystym SSR**: gałąź niepustej listy jest wyspą `client:load`, bo
// usunięcie prowadzi przez okno potwierdzenia (FR-010), a to wymaga JavaScriptu. Hydratacja jest
// jedna niezależnie od liczby drużyn — okno stoi nad całą listą, nie w wierszu (FR-006 nie stawia
// limitu drużyn na konto). Reszta strony — gałąź awarii, stan pusty, baner usunięcia i link
// „Assemble a new team" — zostaje statycznym markupem i do wyspy nie wchodzi.

// `POST /api/teams/[id]/delete` wraca tu z `?deleted=1` po udanym usunięciu. Baner jest jedynym
// potwierdzeniem, gdy zniknęła ostatnia drużyna — lista nie ma wtedy czego pokazać jako dowodu.
const deleted = Astro.url.searchParams.has("deleted");

let teams: readonly TeamListRow[] | null = null;

// Stała lokalizacja i stała strefa: data zapisu ma czytać się tak samo niezależnie od ustawień
// przeglądarki. Formatowanie zostaje po stronie serwera i wchodzi do wyspy gotowym łańcuchem, więc
// hydratacja nie ma się z czym rozjechać — wyspa daty nie formatuje.
const savedAtFormat = new Intl.DateTimeFormat("en-GB", { dateStyle: "medium", timeZone: "UTC" });

const supabase = createClient(Astro.request.headers, Astro.cookies);

// Gałąź `!supabase` jest obroną w głąb: bez kluczy Supabase middleware przekierował na logowanie,
// zanim ten frontmatter się wykonał.
if (supabase) {
  try {
    teams = (await listTeams(supabase)).map((team) => ({
      id: team.id,
      name: team.name,
      savedAt: savedAtFormat.format(new Date(team.createdAt)),
    }));
  } catch (error) {
    // W Workerze log jest jedyną diagnostyką; do gracza idzie komunikat ogólny.
    // eslint-disable-next-line no-console
    console.error("Failed to list teams for /", error);
  }
}
---

<AppLayout title="Your teams">
  <div class="p-4">
    <div class="mx-auto w-full max-w-3xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Your teams
      </h1>
      {
        teams === null ? (
          <div class="rounded-2xl border border-red-400/30 bg-red-500/10 p-8 text-center backdrop-blur-xl">
            <h2 class="text-xl font-semibold text-red-200">Your teams are unavailable right now</h2>
            <p class="mt-2 text-sm text-blue-100/70">Please try again in a moment.</p>
          </div>
        ) : (
          <Fragment>
            {/*
              Baner idzie nad **obie** gałęzie udanego odczytu, ale nigdy nad gałąź awarii wyżej:
              „Team deleted." nad ekranem „Your teams are unavailable right now" byłby sprzecznym
              sygnałem — nie wiadomo, czy usunięcie doszło do skutku.
            */}
            {deleted && (
              <p class="mb-4 rounded-lg border border-emerald-400/30 bg-emerald-500/10 px-3 py-2 text-sm text-emerald-200">
                Team deleted.
              </p>
            )}
            {teams.length === 0 ? (
              <div class="rounded-2xl border border-white/10 bg-white/5 p-8 text-center backdrop-blur-xl">
                <div class="mb-4 text-5xl">🛰️</div>
                <h2 class="text-xl font-semibold">No crew on the books yet</h2>
                <p class="mx-auto mt-2 max-w-md text-sm text-blue-100/70">
                  A team is a crew of up to six characters whose specializations and perks cover all seven competencies.
                  Every team you save shows up here under its call sign.
                </p>
                <a
                  href="/teams/new"
                  class="mt-6 inline-block rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium transition-colors hover:bg-purple-500"
                >
                  Assemble your first team
                </a>
              </div>
            ) : (
              <div class="flex flex-col gap-4">
                <div class="flex justify-end">
                  <a
                    href="/teams/new"
                    class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium transition-colors hover:bg-purple-500"
                  >
                    Assemble a new team
                  </a>
                </div>
                <TeamList teams={teams} client:load />
              </div>
            )}
          </Fragment>
        )
      }
    </div>
  </div>
</AppLayout>
