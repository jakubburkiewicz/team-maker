---
import { ServerError } from "@/components/auth/ServerError";
import DeleteTeamDialog from "@/components/team/DeleteTeamDialog";
import TeamComposer from "@/components/team/TeamComposer";
import TeamNotFound from "@/components/team/TeamNotFound.astro";
import Layout from "@/layouts/Layout.astro";
import { getCharacterPool } from "@/lib/character-pool-repo";
import type { PoolCharacter, TeamComposition } from "@/lib/domain";
import { createClient } from "@/lib/supabase";
import { getTeamDetail, type TeamDetail } from "@/lib/team-repo";
import { resolveSavedTeam } from "@/lib/team-view";

// Zapisana drużyna na jednym ekranie do oglądania i edycji (FR-008 + FR-009) — ten sam
// `TeamComposer` co kompletowanie, różniący się wyłącznie celem zapisu, który niesie `teamId`.
//
// 404 idzie przez `Astro.response.status` i gałąź szablonu, nigdy przez top-level `return`:
// typowana reguła `@typescript-eslint/no-misused-promises` crashuje na nim i wywraca `npm run lint`
// (lekcja z S-03). Mechanizm zostaje; S-07 zmienił wyłącznie **ciało** tej gałęzi — z pustego na
// `<TeamNotFound />`, wspólny z `/teams/[id]/embark`, żeby obie trasy odpowiadały na cudze id
// identycznie co do tytułu, treści i nawigacji.

// `POST /api/teams/[id]` wraca tu z `?saved=1` po udanym zapisie albo z `?error=` przy odrzuceniu.
const saved = Astro.url.searchParams.has("saved");
const error = Astro.url.searchParams.get("error");

// Do logów idzie wersja zakodowana, nigdy surowa: `Astro.params.id` jest po dekodowaniu ścieżki,
// więc `/teams/%0A%0AERROR%20fake` wstrzyknąłby sfabrykowane linie do logów Workera. Do repo idzie
// dalej wartość surowa — formatu pilnuje `isTeamId`. Ten sam kształt mają obie trasy zapisu
// (`src/pages/api/teams/[id].ts`, `src/pages/api/teams/[id]/delete.ts`).
const loggedId = encodeURIComponent(Astro.params.id ?? "");

const supabase = createClient(Astro.request.headers, Astro.cookies);

let team: TeamDetail | null = null;
let pool: readonly PoolCharacter[] | null = null;
// Flaga dotyczy **wyłącznie** odczytu drużyny: 404 nie może zależeć od zapytania niezwiązanego
// z istnieniem wiersza. Awarię puli niesie już `pool === null`, więc nie ma tu drugiej flagi.
//
// Brak klienta liczy się jako awaria odczytu, nie jako brak wiersza: gdyby flaga startowała
// z `false`, `notFound` wyszłoby `true` i **własna** drużyna dostałaby ekran „nie istnieje, albo
// nie jest twoja" — nieprawdę o danych gracza, powiedzianą przez gałąź, której sensem jest
// zachować się poprawnie, gdy pierwsza bariera padnie.
let teamFailed = supabase === null;

// Gałąź `!supabase` jest obroną w głąb: bez kluczy Supabase middleware przekierował na logowanie.
if (supabase) {
  // Oba odczyty naraz — drużyna i pula nie zależą od siebie, więc nie ma powodu na dwa
  // round-tripy po kolei. `allSettled`, bo każda awaria ma własny log.
  const [teamResult, poolResult] = await Promise.allSettled([
    getTeamDetail(supabase, Astro.params.id),
    getCharacterPool(supabase),
  ]);

  if (teamResult.status === "fulfilled") {
    team = teamResult.value;
  } else {
    // W Workerze log jest jedyną diagnostyką; do gracza idzie komunikat ogólny.
    // eslint-disable-next-line no-console
    console.error(`Failed to load team for /teams/${loggedId}`, teamResult.reason);
    teamFailed = true;
  }

  if (poolResult.status === "fulfilled") {
    pool = poolResult.value;
  } else {
    // eslint-disable-next-line no-console
    console.error("Failed to load character pool for /teams/[id]", poolResult.reason);
  }
}

// `null` nierozróżnialnie dla nieznanego id, cudzej drużyny (RLS) i nie-UUID — istnienie cudzego
// rekordu nie może wyciec różnicą w odpowiedzi.
const notFound = !teamFailed && team === null;

let composition: TeamComposition | null = null;
let inconsistent = false;

if (team !== null && pool !== null) {
  const resolved = resolveSavedTeam(team.composition, pool);

  if (resolved.ok) {
    composition = resolved.composition;
  } else {
    inconsistent = true;
    // Ta gałąź **musi** logować: awaria zapytania jest przemijająca i zgłosi się sama, a odrzucony
    // skład oznacza rekord w bazie nie do złożenia z pulą — jedyny stan tego fragmentu, którego
    // bez logu nie da się zdiagnozować w Workerze.
    // eslint-disable-next-line no-console
    console.error(`Saved team ${team.id} cannot be composed from the current character pool`, resolved.violations);
  }
}

if (notFound) {
  Astro.response.status = 404;
}
---

{
  notFound ? (
    <TeamNotFound />
  ) : (
    <Layout title={team ? `Team ${team.name}` : "Team unavailable"}>
      <div class="bg-cosmic min-h-screen p-4 text-white">
        <div class="mx-auto w-full max-w-6xl">
          <div class="mb-6 flex items-center justify-between">
            <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
              {team ? (
                <Fragment>
                  Team <code class="font-mono">{team.name}</code>
                </Fragment>
              ) : (
                "Team"
              )}
            </h1>
            <a href="/teams" class="text-sm text-purple-300 transition-colors hover:text-purple-100 hover:underline">
              ← Your teams
            </a>
          </div>
          {composition !== null && pool !== null ? (
            <div class="flex flex-col gap-4">
              {/*
                Oba paski żyją **wyłącznie** w tej gałęzi: na ekranie 404 i na „drużyna niedostępna"
                nie mają sensu i nie mogą zdradzić, że POST w ogóle dotarł.
              */}
              {saved && (
                <p class="rounded-lg border border-emerald-400/30 bg-emerald-500/10 px-3 py-2 text-sm text-emerald-200">
                  Roster saved.
                </p>
              )}
              <ServerError message={error} />
              <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl">
                <TeamComposer pool={pool} initialComposition={composition} teamId={team.id} client:load />
              </div>
            </div>
          ) : (
            <div class="rounded-2xl border border-red-400/30 bg-red-500/10 p-8 text-center backdrop-blur-xl">
              <h2 class="text-xl font-semibold text-red-200">
                {inconsistent ? "This team no longer matches the character pool" : "Team is unavailable right now"}
              </h2>
              <p class="mx-auto mt-2 max-w-md text-sm text-blue-100/70">
                {inconsistent
                  ? "Its saved roster cannot be assembled from the characters available today, so none of it is shown — a partial roster would not be the team you saved."
                  : "Please try again in a moment."}
              </p>
              <a
                href="/teams"
                class="mt-6 inline-block rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
              >
                Back to your teams
              </a>
            </div>
          )}
          {/*
            Usuwanie żyje przy **każdym** istniejącym własnym wierszu — także gdy skład nie składa się
            z dzisiejszej puli (`inconsistent`) albo pula chwilowo nie doszła: usunięcie nie potrzebuje
            puli, a nagłówek wyżej i tak już nazywa drużynę. Przycisku nie ma tylko przy `notFound`
            (cała strona to `<TeamNotFound />`) i `teamFailed` (`team === null`) — tam nie ma czego usuwać, a sam
            przycisk zdradziłby, że wiersz istnieje (US-04).
          */}
          {team !== null && (
            <div class="mt-4 flex flex-col">
              <DeleteTeamDialog teamId={team.id} teamName={team.name} client:load />
            </div>
          )}
        </div>
      </div>
    </Layout>
  )
}
