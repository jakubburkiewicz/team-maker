---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { getTeamSummary, type TeamSummary } from "@/lib/team-repo";

// Potwierdzenie zapisu (FR-019): nazwa jest **odczytana z bazy**, nie z adresu — dowód trwałości,
// nie echo. Trasa chroniona prefiksem `/teams` w middleware.
//
// Gołe 404 idzie przez `Astro.response.status` i pustą gałąź szablonu, nie przez `return new
// Response(...)` na szczycie frontmattera: typowana reguła `@typescript-eslint/no-misused-promises`
// crashuje na top-level `return` (w zwykłym TS to błąd składni, więc reguła zakłada funkcję-przodka)
// i wywraca `npm run lint`. Efekt dla klienta ten sam — 404 z pustym ciałem.
const supabase = createClient(Astro.request.headers, Astro.cookies);

let team: TeamSummary | null = null;
let failed = false;

// Gałąź `!supabase` jest nieosiągalna — bez kluczy Supabase middleware przekierował na logowanie.
if (supabase) {
  try {
    // `null` zarówno dla nieznanego id, cudzej drużyny (RLS), jak i nie-UUID — bez rozróżnienia,
    // żeby nie ujawniać istnienia cudzego rekordu. S-07 rozstrzyga docelowo (404 vs redirect).
    team = await getTeamSummary(supabase, Astro.params.id);
  } catch (error) {
    // W Workerze log jest jedyną diagnostyką; do gracza idzie komunikat ogólny.
    // eslint-disable-next-line no-console
    console.error(`Failed to load team for /teams/${Astro.params.id ?? ""}/embark`, error);
    failed = true;
  }
}

const notFound = !failed && team === null;

if (notFound) {
  Astro.response.status = 404;
}
---

{
  notFound ? null : (
    <Layout title={team ? `Team ${team.name} saved` : "Team unavailable"}>
      <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
        {team ? (
          <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
            <div class="mb-4 text-5xl">🚀</div>
            <h1 class="mb-3 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
              Team <code class="font-mono">{team.name}</code> is saved
            </h1>
            <p class="mb-6 text-blue-100/80">
              Your crew is on the books under the call sign <code class="font-mono text-white">{team.name}</code>.
            </p>
            <div class="mb-6 rounded-lg border border-amber-400/30 bg-amber-500/10 px-4 py-3 text-left">
              <p class="text-sm font-semibold text-amber-200">Work in Progress</p>
              <p class="mt-1 text-sm text-blue-100/70">
                Missions are not part of this build — this is where the job ends for now.
              </p>
            </div>
            <div class="flex flex-col gap-2 text-sm">
              <a href="/teams/new" class="text-purple-300 hover:underline">
                Assemble another team
              </a>
              <a href="/dashboard" class="text-purple-300 hover:underline">
                Back to dashboard
              </a>
            </div>
          </div>
        ) : (
          <div class="w-full max-w-sm rounded-2xl border border-red-400/30 bg-red-500/10 p-8 text-center text-white backdrop-blur-xl">
            <h1 class="text-xl font-semibold text-red-200">Team is unavailable right now</h1>
            <p class="mt-2 text-sm text-blue-100/70">Please try again in a moment.</p>
            <a
              href="/dashboard"
              class="mt-6 inline-block rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
            >
              Back to dashboard
            </a>
          </div>
        )}
      </div>
    </Layout>
  )
}
