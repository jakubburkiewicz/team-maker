---
import Layout from "@/layouts/Layout.astro";

// Wspólna odpowiedź obu tras dynamicznych na `notFound` (US-04, FR-004). Komponent renderuje
// **własny** `Layout`, więc strona wywołująca podaje samo `<TeamNotFound />` i nie ma czym rozjechać
// ani tytułu zakładki, ani treści. To jest sedno: różnica między odpowiedziami `/teams/[id]`
// a `/teams/[id]/embark` na to samo cudze id ujawniałaby, że trasy wiedzą o wierszu różne rzeczy —
// awaria cicha i jednocześnie wyciek. Stąd też brak propsów: każdy prop byłby miejscem rozjazdu.
//
// Zdanie jest **łączne** celowo. Nazywa regułę izolacji, nie zdradzając, który z trzech przypadków
// zaszedł: nieznane id, cudzy wiersz odcięty przez RLS, własna drużyna skasowana chwilę wcześniej.
// Repo zwraca dla wszystkich trzech `null` nierozróżnialnie (`src/lib/team-repo.ts:11-14`) — ekran
// nie ma prawa być bardziej rozmowny niż warstwa pod nim.
//
// Status 404 zostaje na stronie wywołującej (`Astro.response.status`), bo komponent nie ma dostępu
// do jej odpowiedzi — i tak ma być: top-level `return` we frontmatterze wywraca `npm run lint`
// (lekcja z S-03).
//
// Paleta jest neutralna, nie czerwona. Czerwona karta należy do „Team is unavailable right now" —
// awarii zapytania, której atakujący nie potrafi wywołać. Brak wiersza nie jest usterką systemu.
---

<Layout title="Team not found">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <h1 class="text-xl font-semibold text-blue-100">Team not found</h1>
      <p class="mt-2 text-sm text-blue-100/70">This team does not exist, or it is not yours.</p>
      <div class="mt-6 flex flex-col gap-2 text-sm">
        <a href="/" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline"> Your teams </a>
      </div>
    </div>
  </div>
</Layout>
