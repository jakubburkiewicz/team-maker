---
import AppHeader from "@/components/AppHeader.astro";
import Layout from "@/layouts/Layout.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;

// Powłoka stron domenowych. **Wybór tego layoutu jest jedynym przełącznikiem** obecności
// nagłówka — nie ma propsa włączającego pasek, bo taki prop byłby cichym przełącznikiem:
// nowa strona zapomniałaby go podać i po prostu nie miałaby nagłówka, czego nie łapie ani lint,
// ani typy (`context/foundation/lessons.md`). `/auth/*` zostaje przy gołym `Layout.astro`.
//
// Powłoka **nie wnosi kontenera treści** — każda strona zachowuje swój własny
// (`max-w-3xl`, `max-w-6xl` albo wyśrodkowaną kartę `max-w-sm`). Trzy powody:
//   1. Strony mają dwa różne układy (górno-wyrównany i wyśrodkowana karta); prop je rozróżniający
//      byłby dokładnie tym cichym przełącznikiem z akapitu wyżej.
//   2. `min-h-screen` w dwóch miejscach naraz daje wysokość `nagłówek + 100vh`, czyli stały
//      martwy pasek przewijania na każdym ekranie powłoki. Dlatego `min-h-screen` żyje wyłącznie
//      tutaj, a strony przechodzą na `flex-1`.
//   3. `bg-cosmic` (`src/styles/global.css:113-115`) ustawia **tylko** `background-image`.
//      Nagłówek wyrenderowany nad pudełkiem z tą klasą malowałby się na `bg-background` —
//      widoczny szew poziomy. Nagłówek musi być **wewnątrz** pudełka niosącego `bg-cosmic`.
---

<Layout title={title}>
  <div class="bg-cosmic flex min-h-screen flex-col text-white">
    <AppHeader />
    <div class="flex flex-1 flex-col">
      <slot />
    </div>
  </div>
</Layout>
